{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "echo y | wrangler d1 migrations apply index-db --local",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply index-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply index-db --local",
    "seed:r2": "node scripts/seed-local-r2.mjs",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@index/shared": "workspace:*",
    "hono": "^4.12.23",
    "zod": "^3.24.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260603.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.97.0"
  }
}
